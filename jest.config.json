{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "src",
  "testRegex": ".*\\.test\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "**/*.(t|j)s"
  ],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "@v1/(.*)": "<rootDir>/modules/v1/$1",
    "@common/(.*)": "<rootDir>/common/$1",
    "@core/(.*)": "<rootDir>/core/$1"
  }
}