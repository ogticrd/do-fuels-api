# Ignore node_modules directory
node_modules

# Ignore local development logs
npm-debug.log
yarn-debug.log
yarn-error.log

# Ignore environment variables
.env
.env.*  # If you have multiple environment files like .env.development, .env.production, etc.

# Ignore output directories
dist
build

# Ignore Docker files
Dockerfile*
docker-compose*.yml

# Ignore test files and coverage reports
coverage
test
tests
*.spec.ts
*.test.ts

# Ignore local configuration files
.idea
.vscode
*.iml

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore Git files
.git
.gitignore

# Ignore any other editor or IDE related files
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
*.code-workspace

# Ignore temporary files
tmp
temp
*.tmp

# Ignore other potentially sensitive files
*.pem
*.key
*.crt